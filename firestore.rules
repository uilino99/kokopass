rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // User profile docs.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ['farmer', 'exporter', 'buyer'];
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Farm docs are keyed by farmer UID.
    match /farms/{farmId} {
      allow read: if isSignedIn();   // exporters/buyers can look up farm metadata
      allow create, update: if isOwner(farmId)
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // Batches: owner can write, anyone can read for QR verification.
    match /batches/{batchId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Exports owned by exporter accounts (used by exporter flow later).
    match /exports/{exportId} {
      allow read: if true;
      allow create: if isSignedIn()
        && userRole() == 'exporter'
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Transactions: payments / sales between farmers and exporters.
    match /transactions/{txId} {
      allow read: if isSignedIn() && (
        resource.data.farmerUid == request.auth.uid ||
        resource.data.exporterUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && userRole() == 'exporter'
        && request.resource.data.exporterUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.exporterUid == request.auth.uid;
      allow delete: if false;
    }

    // Weather alerts: server-written, broadly readable.
    match /weather_alerts/{alertId} {
      allow read: if true;
      allow write: if false; // written by Cloud Functions / admin SDK
    }

    // Buyer portfolios: each buyer owns their dashboard config doc.
    match /buyer_portfolios/{buyerId} {
      allow read: if isOwner(buyerId);
      allow create, update: if isOwner(buyerId)
        && userRole() == 'buyer'
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // AI predictions: server-written, owner-readable.
    match /ai_predictions/{predId} {
      allow read: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow write: if false; // written by Cloud Functions / admin SDK
    }

    // Audit logs: append-only, never client-readable.
    match /audit_logs/{logId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
