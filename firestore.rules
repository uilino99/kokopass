rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // ---------- Platform & organization helpers ----------
    // Platform admin = KokoPass internal team. Set via Cloud Function /
    // Admin SDK only. Never settable by the client.
    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    // Custom claims mirror organization memberships:
    //   request.auth.token.orgs = { '<orgId>': '<role>' }
    // Maintained by the syncMembershipClaims Cloud Function.
    function orgRole(orgId) {
      return isSignedIn() && (orgId in request.auth.token.get('orgs', {}))
        ? request.auth.token.orgs[orgId]
        : null;
    }
    function isOrgMember(orgId) {
      return orgRole(orgId) != null;
    }
    function isOrgAdmin(orgId) {
      return orgRole(orgId) == 'admin';
    }

    // ---------- Users ----------
    match /users/{userId} {
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ['farmer', 'exporter', 'buyer', 'enroller'];
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // ---------- Farms ----------
    match /farms/{farmId} {
      allow read: if true;
      allow create, update: if (isOwner(farmId)
        && request.resource.data.ownerUid == request.auth.uid)
        || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // ---------- Batches ----------
    match /batches/{batchId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (isSignedIn()
        && resource.data.ownerUid == request.auth.uid)
        || isPlatformAdmin();
      allow delete: if (isSignedIn()
        && resource.data.ownerUid == request.auth.uid)
        || isPlatformAdmin();
    }

    // ---------- Exports (shipments) ----------
    match /exports/{exportId} {
      allow read: if true;
      allow create: if isSignedIn()
        && userRole() == 'exporter'
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if (isSignedIn()
        && resource.data.ownerUid == request.auth.uid)
        || isPlatformAdmin();
    }

    // ---------- Public exporter profiles ----------
    match /exporterProfiles/{uid} {
      allow read: if true;
      allow create, update: if (isOwner(uid)
        && userRole() == 'exporter'
        && request.resource.data.ownerUid == request.auth.uid)
        || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // ---------- Inquiries ----------
    match /inquiries/{id} {
      // Target exporter sees their inbox; platform admin sees all for
      // fraud monitoring.
      allow read: if isPlatformAdmin()
        || (isSignedIn() && resource.data.targetUid == request.auth.uid);
      allow create: if
        request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 2000
        && request.resource.data.status == 'new';
      allow update: if (isSignedIn()
        && resource.data.targetUid == request.auth.uid
        && request.resource.data.targetUid == resource.data.targetUid)
        || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // ---------- Transactions ----------
    match /transactions/{txId} {
      allow read: if isPlatformAdmin() || (isSignedIn() && (
        resource.data.farmerUid == request.auth.uid ||
        resource.data.exporterUid == request.auth.uid
      ));
      allow create: if isSignedIn()
        && userRole() == 'exporter'
        && request.resource.data.exporterUid == request.auth.uid;
      allow update: if (isSignedIn()
        && resource.data.exporterUid == request.auth.uid)
        || isPlatformAdmin();
      allow delete: if false;
    }

    // ---------- Weather alerts ----------
    match /weather_alerts/{alertId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- Buyer portfolios ----------
    match /buyer_portfolios/{buyerId} {
      allow read: if isOwner(buyerId) || isPlatformAdmin();
      allow create, update: if isOwner(buyerId)
        && userRole() == 'buyer'
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // ---------- AI predictions ----------
    match /ai_predictions/{predId} {
      allow read: if isPlatformAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if false;
    }

    // ---------- Aggregates ----------
    match /aggregates/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- Audit logs ----------
    // Written exclusively by Cloud Functions (admin SDK bypasses rules).
    // Readable by the platform admin, and by org admins when the log is
    // scoped to their org.
    match /audit_logs/{logId} {
      allow read: if isPlatformAdmin()
        || (resource.data.orgId != null && isOrgAdmin(resource.data.orgId));
      allow write: if false;
    }

    // ---------- Pre-enrollments ----------
    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        // (a) Standalone enroller account (no org).
        (userRole() == 'enroller'
          && request.resource.data.enrollerUid == request.auth.uid
          && request.resource.data.claimed == false)
        ||
        // (b) Org-scoped field agent or admin. The org claim is checked
        // against the orgId being written into the doc, and the actor
        // must list themselves on both enrollerUid and fieldAgentUid.
        (request.resource.data.orgId is string
          && request.resource.data.orgId.size() > 0
          && request.resource.data.enrollerUid == request.auth.uid
          && request.resource.data.fieldAgentUid == request.auth.uid
          && request.resource.data.claimed == false
          && (orgRole(request.resource.data.orgId) == 'fieldAgent'
              || orgRole(request.resource.data.orgId) == 'admin'))
      );
      allow update: if isSignedIn() && (
        // Standalone enroller editing their own record (still unclaimed).
        (userRole() == 'enroller'
          && resource.data.enrollerUid == request.auth.uid
          && resource.data.claimed == false)
        ||
        // The field agent who created the org-scoped record can edit it.
        (resource.data.orgId is string
          && resource.data.fieldAgentUid == request.auth.uid
          && resource.data.claimed == false)
        ||
        // Org admin of the owning org can edit any unclaimed record.
        (resource.data.orgId is string
          && resource.data.claimed == false
          && orgRole(resource.data.orgId) == 'admin')
        ||
        // Claim flow: anyone signed in can flip claimed -> true onto
        // themselves.
        (resource.data.claimed == false
          && request.resource.data.claimed == true
          && request.resource.data.claimedUid == request.auth.uid)
      ) || isPlatformAdmin();
      allow delete: if isSignedIn() && (
        (userRole() == 'enroller'
          && resource.data.enrollerUid == request.auth.uid
          && resource.data.claimed == false)
        ||
        (resource.data.orgId is string
          && resource.data.fieldAgentUid == request.auth.uid
          && resource.data.claimed == false)
        ||
        (resource.data.orgId is string
          && resource.data.claimed == false
          && orgRole(resource.data.orgId) == 'admin')
      ) || isPlatformAdmin();
    }

    // ---------- Scans ----------
    match /scans/{scanId} {
      allow read: if (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || isPlatformAdmin();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if (isSignedIn() && resource.data.ownerUid == request.auth.uid)
        || isPlatformAdmin();
    }

    // ---------- Organizations ----------
    // Public-read by default (organizations want discoverability); the
    // owner / org admins / platform admin can write.
    match /organizations/{orgId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.type in
          ['government', 'ngo', 'cooperative', 'certifier', 'buyer', 'private'];
      allow update: if isOrgAdmin(orgId) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();

      // Memberships — one doc per user per org, keyed by the user's UID.
      match /members/{memberUid} {
        // A member can read their own record; org admins read all
        // members; platform admin reads everywhere.
        allow read: if isOwner(memberUid)
          || isOrgAdmin(orgId)
          || isPlatformAdmin();
        // First-member bootstrap: the org creator (ownerUid) can add
        // themselves as the first admin. Subsequent members can only be
        // added by an existing org admin or the platform admin.
        allow create: if isPlatformAdmin()
          || isOrgAdmin(orgId)
          || (
            isOwner(memberUid)
            && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid == request.auth.uid
            && request.resource.data.role == 'admin'
            && request.resource.data.uid == memberUid
          );
        allow update: if isOrgAdmin(orgId) || isPlatformAdmin();
        // A member can remove themselves; admins can remove anyone in
        // their org; platform admin overrides everything.
        allow delete: if isOwner(memberUid)
          || isOrgAdmin(orgId)
          || isPlatformAdmin();
      }

      // Territories (geographic assignment areas).
      match /territories/{territoryId} {
        allow read: if true;
        allow create, update, delete: if isOrgAdmin(orgId) || isPlatformAdmin();
      }

      // Certification / compliance programs.
      match /programs/{programId} {
        allow read: if true;
        allow create, update, delete: if isOrgAdmin(orgId) || isPlatformAdmin();
      }
    }
  }
}
