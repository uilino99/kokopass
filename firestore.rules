rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // User profile docs.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ['farmer', 'exporter', 'buyer', 'enroller'];
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Farm docs are keyed by farmer UID.
    match /farms/{farmId} {
      // Public read — farm metadata is already snapshot onto batches and
      // surfaced on the public /verify page; exposing the canonical doc
      // doesn't reveal anything new and lets the marketing page show
      // aggregate counts without requiring auth.
      allow read: if true;
      allow create, update: if isOwner(farmId)
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // Batches: owner can write, anyone can read for QR verification.
    match /batches/{batchId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Exports owned by exporter accounts (used by exporter flow later).
    match /exports/{exportId} {
      allow read: if true;
      allow create: if isSignedIn()
        && userRole() == 'exporter'
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Public exporter profiles (the /exporters directory).
    match /exporterProfiles/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && userRole() == 'exporter'
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // Transactions: payments / sales between farmers and exporters.
    match /transactions/{txId} {
      allow read: if isSignedIn() && (
        resource.data.farmerUid == request.auth.uid ||
        resource.data.exporterUid == request.auth.uid
      );
      allow create: if isSignedIn()
        && userRole() == 'exporter'
        && request.resource.data.exporterUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.exporterUid == request.auth.uid;
      allow delete: if false;
    }

    // Weather alerts: server-written, broadly readable.
    match /weather_alerts/{alertId} {
      allow read: if true;
      allow write: if false; // written by Cloud Functions / admin SDK
    }

    // Buyer portfolios: each buyer owns their dashboard config doc.
    match /buyer_portfolios/{buyerId} {
      allow read: if isOwner(buyerId);
      allow create, update: if isOwner(buyerId)
        && userRole() == 'buyer'
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    // AI predictions: server-written, owner-readable.
    match /ai_predictions/{predId} {
      allow read: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow write: if false; // written by Cloud Functions / admin SDK
    }

    // Server-maintained global aggregates (written by Cloud Functions only).
    // Public read so the Landing page could prefer this over per-collection
    // counts once the functions are deployed.
    match /aggregates/{docId} {
      allow read: if true;
      allow write: if false; // admin SDK bypasses rules
    }

    // Audit logs: append-only, never client-readable.
    match /audit_logs/{logId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Pre-enrollments: village rep / NGO field officer (role='enroller')
    // bulk-adds farmer records before those farmers have Firebase Auth
    // accounts. Each pre-enrollment owns a `claimCode` farmers can later
    // redeem to claim the data into their own /farms/{uid} doc.
    match /enrollments/{enrollmentId} {
      // Public read OK (low-risk metadata, supports lookup by code).
      allow read: if true;
      allow create: if isSignedIn()
        && userRole() == 'enroller'
        && request.resource.data.enrollerUid == request.auth.uid
        && request.resource.data.claimed == false;
      allow update: if isSignedIn() && (
        // Enroller editing their own record (still unclaimed).
        (userRole() == 'enroller'
          && resource.data.enrollerUid == request.auth.uid
          && resource.data.claimed == false)
        ||
        // Anyone can claim an unclaimed record by setting claimed/claimedUid
        // to themselves (claim flow).
        (resource.data.claimed == false
          && request.resource.data.claimed == true
          && request.resource.data.claimedUid == request.auth.uid)
      );
      allow delete: if isSignedIn()
        && userRole() == 'enroller'
        && resource.data.enrollerUid == request.auth.uid
        && resource.data.claimed == false;
    }

    // Scans: a buyer's traceability portfolio. Deterministic doc IDs of
    // the form "{ownerUid}_{refId}" make re-scanning the same QR an
    // idempotent merge that just refreshes scannedAt.
    match /scans/{scanId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
