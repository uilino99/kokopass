rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isImageWithin(maxBytes) {
      return request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    // Farmer / user avatars: users/{uid}/avatar.jpg
    match /users/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isImageWithin(5 * 1024 * 1024);
    }

    // Farm hero / gallery: farms/{uid}/...
    match /farms/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isImageWithin(5 * 1024 * 1024);
    }

    // Batch photos keyed by owner so we can validate without reading Firestore.
    // Path: batches/{ownerUid}/{batchId}/photo-{n}.jpg
    match /batches/{ownerUid}/{batchId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && isImageWithin(5 * 1024 * 1024);
    }

    // Exporter logos / hero photos: exporters/{uid}/...
    match /exporters/{uid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isImageWithin(5 * 1024 * 1024);
    }

    // Organization logos / assets keyed by the uploading user, since
    // Storage rules can't cheaply check Firestore org membership.
    // Multiple admins of the same org each upload under their own UID
    // space; the org doc stores the resulting download URL.
    // Path: organizations/{uploaderUid}/{orgId-or-token}/...
    match /organizations/{uploaderUid}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uploaderUid
        && isImageWithin(5 * 1024 * 1024);
    }
  }
}
